# Anthropic API key used to power the AI extraction agent.
# Get one at https://console.anthropic.com/
# If left empty, the backend automatically falls back to a built-in
# rule-based extractor so the app still works end-to-end without a key.
ANTHROPIC_API_KEY=

# Model to use for extraction (optional, defaults shown below)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Port the backend server listens on
PORT=5000

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGIN=http://localhost:5173
